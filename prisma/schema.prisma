generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
    url      = env("DATABASE_URL")

}

model Patient {
  id                    String   @id @default(uuid())
  fullName              String
  email                 String
  phone                 String
  dateOfBirth           DateTime?
  gender                String?
  address               String?
  occupation            String?
  emergencyContactName    String?
  emergencyContactNumber  String?
  primaryPhysicianId    String?
  primaryPhysician      Doctor?  @relation(fields: [primaryPhysicianId], references: [id], onDelete: SetNull)
  insuranceProvider      String?
  insurancePolicyNumber  String?
  allergies             String?
  currentMedication     String?
  identificationType    String?
  identificationNumber  String?
  consentTerms          Boolean?
  consentPrivacy        Boolean?
  consentTreatment      Boolean?
  createdAt             DateTime @default(now())
    otps         PatientOTP[]
  appointments          Appointment[]
    labTests     LabTest[]
      prescriptions Prescription[]
  orders        Order[]

}

model Doctor {
  id           String    @id @default(uuid())
  name         String
  specialty    String?
  email        String    @unique
  password     String
  createdAt    DateTime  @default(now())
  appointments Appointment[]
  patients     Patient[]
  labTests     LabTest[]
  prescriptions Prescription[]
  availability  Availability[]
}
model Appointment {
  id                String    @id @default(uuid())
  patientId         String
  doctorId          String
  date              DateTime
  reason            String
  notes             String?
  diagnosis         String?
  requiresLabTest   Boolean   @default(false)
  status            String    @default("pending")
  rejectionReason   String?
  rescheduledDate   DateTime?
  videoRoomUrl      String?
  videoRoomName     String?
  createdAt         DateTime  @default(now())

  patient   Patient  @relation(fields: [patientId], references: [id], onDelete: Cascade)
  doctor    Doctor   @relation(fields: [doctorId],  references: [id], onDelete: Cascade)
    labTests     LabTest[]
      prescriptions Prescription[]
}
model Admin {
  id        String   @id @default(uuid())
  email     String   @unique
  password  String
  createdAt DateTime @default(now())
}

model PatientOTP {
  id        String   @id @default(uuid())
  patientId String
  code      String
  expiresAt DateTime
  used      Boolean  @default(false)
  createdAt DateTime @default(now())

  patient   Patient  @relation(fields: [patientId], references: [id], onDelete: Cascade)
}

model LabTest {
  id            String    @id @default(uuid())
  appointmentId String
  patientId     String
  doctorId      String
  testName      String
  status        String    @default("ordered")
  resultUrl     String?
  resultNotes   String?
  orderedAt     DateTime  @default(now())
  completedAt   DateTime?

  appointment   Appointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  patient       Patient     @relation(fields: [patientId], references: [id], onDelete: Cascade)
  doctor        Doctor      @relation(fields: [doctorId],    references: [id], onDelete: Cascade)
}

model Prescription {
  id            String   @id @default(uuid())
  appointmentId String
  patientId     String
  doctorId      String
  diagnosis     String?
  notes         String?
  status        String   @default("pending")
  createdAt     DateTime @default(now())

  appointment   Appointment        @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  patient       Patient            @relation(fields: [patientId],     references: [id], onDelete: Cascade)
  doctor        Doctor             @relation(fields: [doctorId],      references: [id], onDelete: Cascade)
  items         PrescriptionItem[]
    order         Order?

}

model PrescriptionItem {
  id             String       @id @default(uuid())
  prescriptionId String
  drugName       String
  dosage         String
  frequency      String
  duration       String
  price          Float        @default(0)
  notes          String?

  prescription   Prescription @relation(fields: [prescriptionId], references: [id], onDelete: Cascade)
}

model Drug {
  id          String   @id @default(uuid())
  name        String
  genericName String?
  category    String?
  unit        String   @default("tablet")
  price       Float
  inStock     Boolean  @default(true)
  createdAt   DateTime @default(now())
}

model Order {
  id             String    @id @default(uuid())
  prescriptionId String    @unique
  patientId      String
  deliveryAddress String
  status         String    @default("packed")
  totalAmount    Float
  paystackRef    String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  prescription   Prescription @relation(fields: [prescriptionId], references: [id], onDelete: Cascade)
  patient        Patient      @relation(fields: [patientId],      references: [id], onDelete: Cascade)
}

model Availability {
  id        String   @id @default(uuid())
  doctorId  String
  dayOfWeek Int      // 0 = Sunday, 1 = Monday ... 6 = Saturday
  startTime String   // "09:00"
  endTime   String   // "17:00"
  slotDurationMins Int @default(30)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())

  doctor    Doctor   @relation(fields: [doctorId], references: [id], onDelete: Cascade)
}