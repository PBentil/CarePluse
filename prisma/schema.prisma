generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}


model Hospital {
  id                 String    @id @default(uuid())
  name               String
  slug               String    @unique
  email              String    @unique
  phone              String
  address            String?
  logoUrl            String?
  plan               String    @default("starter")
  subscriptionStatus String    @default("trial")
  subscriptionExpiry DateTime?
  paystackCustomerId String?
  createdAt          DateTime  @default(now())

  clinics       Clinic[]
  staff         Staff[]
  patients      Patient[]
  doctors       Doctor[]
  appointments  Appointment[]
  labTests      LabTest[]
  prescriptions Prescription[]
  orders        Order[]
  drugs         Drug[]
  subscription  Subscription?
  pushSubscriptions PushSubscription[]


}

model Subscription {
  id             String   @id @default(uuid())
  hospitalId     String   @unique
  plan           String
  status         String   @default("active")
  amount         Float
  paystackRef    String?
  currentPeriodStart DateTime
  currentPeriodEnd   DateTime
  createdAt      DateTime @default(now())

  hospital       Hospital @relation(fields: [hospitalId], references: [id], onDelete: Cascade)
}

model Clinic {
  id         String   @id @default(uuid())
  hospitalId String
  name       String
  address    String?
  phone      String?
  isDefault  Boolean  @default(false)
  createdAt  DateTime @default(now())

  hospital     Hospital      @relation(fields: [hospitalId], references: [id], onDelete: Cascade)
  staff        Staff[]
  doctors      Doctor[]
  appointments Appointment[]
  patients     Patient[]
}


model Staff {
  id         String   @id @default(uuid())
  hospitalId String
  clinicId   String?
  name       String
  email      String
  password   String
  role       String   // hospital_admin | nurse | receptionist | pharmacist
  isActive   Boolean  @default(true)
  createdAt  DateTime @default(now())

  hospital   Hospital @relation(fields: [hospitalId], references: [id], onDelete: Cascade)
  clinic     Clinic?  @relation(fields: [clinicId], references: [id], onDelete: SetNull)

  @@unique([email, hospitalId])
}

model SuperAdmin {
  id        String   @id @default(uuid())
  email     String   @unique
  password  String
  createdAt DateTime @default(now())
}


model Doctor {
  id           String   @id @default(uuid())
  hospitalId   String
  clinicId     String?
  name         String
  specialty    String?
  email        String
  password     String
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())

  hospital      Hospital       @relation(fields: [hospitalId], references: [id], onDelete: Cascade)
  clinic        Clinic?        @relation(fields: [clinicId], references: [id], onDelete: SetNull)
  appointments  Appointment[]
  patients      Patient[]
  labTests      LabTest[]
  prescriptions Prescription[]
  availability  Availability[]

  @@unique([email, hospitalId])
}

model Availability {
  id               String   @id @default(uuid())
  doctorId         String
  hospitalId       String
  dayOfWeek        Int
  startTime        String
  endTime          String
  slotDurationMins Int      @default(30)
  isActive         Boolean  @default(true)
  createdAt        DateTime @default(now())

  doctor   Doctor @relation(fields: [doctorId], references: [id], onDelete: Cascade)
}


model Patient {
  id                       String    @id @default(uuid())
  hospitalId               String
  clinicId                 String?
  fullName                 String
  email                    String
  phone                    String
  dateOfBirth              DateTime?
  gender                   String?
  address                  String?
  occupation               String?
  emergencyContactName     String?
  emergencyContactNumber   String?
  primaryPhysicianId       String?
  insuranceProvider        String?
  insurancePolicyNumber    String?
  allergies                String?
  currentMedication        String?
  identificationType       String?
  identificationNumber     String?
  identificationDocumentUrl String?
  consentTerms             Boolean?
  consentPrivacy           Boolean?
  consentTreatment         Boolean?
  createdAt                DateTime  @default(now())

  hospital      Hospital       @relation(fields: [hospitalId], references: [id], onDelete: Cascade)
  clinic        Clinic?        @relation(fields: [clinicId], references: [id], onDelete: SetNull)
  primaryPhysician Doctor?     @relation(fields: [primaryPhysicianId], references: [id], onDelete: SetNull)
  appointments  Appointment[]
  labTests      LabTest[]
  prescriptions Prescription[]
  orders        Order[]
  otps          PatientOTP[]
}

model PatientOTP {
  id        String   @id @default(uuid())
  patientId String
  code      String
  expiresAt DateTime
  used      Boolean  @default(false)
  createdAt DateTime @default(now())

  patient   Patient  @relation(fields: [patientId], references: [id], onDelete: Cascade)
}


model Appointment {
  id              String    @id @default(uuid())
  hospitalId      String
  clinicId        String?
  patientId       String
  doctorId        String
  date            DateTime
  reason          String
  notes           String?
  diagnosis       String?
  requiresLabTest Boolean   @default(false)
  status          String    @default("pending")
  rejectionReason String?
  rescheduledDate DateTime?
  videoRoomUrl    String?
  videoRoomName   String?
  createdAt       DateTime  @default(now())

  hospital      Hospital       @relation(fields: [hospitalId], references: [id], onDelete: Cascade)
  clinic        Clinic?        @relation(fields: [clinicId], references: [id], onDelete: SetNull)
  patient       Patient        @relation(fields: [patientId], references: [id], onDelete: Cascade)
  doctor        Doctor         @relation(fields: [doctorId], references: [id], onDelete: Cascade)
  labTests      LabTest[]
  prescriptions Prescription[]
}


model LabTest {
  id            String    @id @default(uuid())
  hospitalId    String
  appointmentId String
  patientId     String
  doctorId      String
  testName      String
  status        String    @default("ordered")
  resultUrl     String?
  resultNotes   String?
  orderedAt     DateTime  @default(now())
  completedAt   DateTime?

  hospital    Hospital    @relation(fields: [hospitalId], references: [id], onDelete: Cascade)
  appointment Appointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  patient     Patient     @relation(fields: [patientId], references: [id], onDelete: Cascade)
  doctor      Doctor      @relation(fields: [doctorId], references: [id], onDelete: Cascade)
}



model Prescription {
  id            String   @id @default(uuid())
  hospitalId    String
  appointmentId String
  patientId     String
  doctorId      String
  diagnosis     String?
  notes         String?
  status        String   @default("pending")
  createdAt     DateTime @default(now())

  hospital    Hospital         @relation(fields: [hospitalId], references: [id], onDelete: Cascade)
  appointment Appointment      @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  patient     Patient          @relation(fields: [patientId], references: [id], onDelete: Cascade)
  doctor      Doctor           @relation(fields: [doctorId], references: [id], onDelete: Cascade)
  items       PrescriptionItem[]
  order       Order?
}

model PrescriptionItem {
  id             String       @id @default(uuid())
  prescriptionId String
  drugName       String
  dosage         String
  frequency      String
  duration       String
  price          Float        @default(0)
  notes          String?

  prescription Prescription @relation(fields: [prescriptionId], references: [id], onDelete: Cascade)
}


model Drug {
  id          String   @id @default(uuid())
  hospitalId  String
  name        String
  genericName String?
  category    String?
  unit        String   @default("tablet")
  price       Float
  inStock     Boolean  @default(true)
  createdAt   DateTime @default(now())

  hospital Hospital @relation(fields: [hospitalId], references: [id], onDelete: Cascade)
}


model Order {
  id              String   @id @default(uuid())
  hospitalId      String
  prescriptionId  String   @unique
  patientId       String
  deliveryAddress String
  status          String   @default("packed")
  totalAmount     Float
  paystackRef     String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  hospital     Hospital     @relation(fields: [hospitalId], references: [id], onDelete: Cascade)
  prescription Prescription @relation(fields: [prescriptionId], references: [id], onDelete: Cascade)
  patient      Patient      @relation(fields: [patientId], references: [id], onDelete: Cascade)
}

model PushSubscription {
  id         String   @id @default(uuid())
  hospitalId String
  userId     String
  userType   String   // doctor | patient | staff
  endpoint   String   @unique
  p256dh     String
  auth       String
  createdAt  DateTime @default(now())

  hospital   Hospital @relation(fields: [hospitalId], references: [id], onDelete: Cascade)
}